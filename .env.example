# Copy to .env in the repository root. .env is private and ignored by Git.
# All values are optional until you use the matching tool. Blank means unset.
# Priority: explicit CLI argument > process environment > .env > tool default.
# Paths may be absolute or relative to the repository. Quotes are literal:
# Windows backslashes, $, # and backticks are not expanded inside quotes.

# Musical data for firmware and optional archival workbench only.
# The browser Client and desktop Client do not require this input.
THY666_CHORD_ARCHIVE=".tools/inputs/chords.lossless.json"
THY666_CHORD_DUMP=

# Optional existing Zig installation: set BOTH executable and its SHA-256.
# Leave both empty to use the verified installation from npm run setup.
THY666_ZIG_EXECUTABLE=
THY666_ZIG_SHA256=

# Local companion server. It always binds to 127.0.0.1.
THY666_WORKBENCH_PORT=3330

# Device bindings for PowerShell support/capture tools.
# A COM port name alone is not a device identity; keep serial/hub checks.
THY666_SERIAL_PORT=
THY666_DEVICE_SERIAL=
THY666_USB_HUB_PARENT=
THY666_EXPECTED_BUILD=

# Windows MIDI capture input and its matching PnP interface path.
THY666_MIDI_INPUT_NAME=
THY666_MIDI_INTERFACE_PATH=

# Optional USBPcap installation/root and selected USB addresses.
# Addresses are comma-separated; CaptureAll does not require this value.
THY666_USBPCAP_PATH=
THY666_USBPCAP_DEVICE=
THY666_USBPCAP_ADDRESSES=
